        ["alice@c-alice", "s3:PutObject", "arn:aws:s3:::b/k", "ImplicitDeny"],
        ["anonymous", "s3:PutObject", "arn:aws:s3:::b/k", "ImplicitDeny"]
      ]
    },
    {
      "name": "string operators on request headers",
