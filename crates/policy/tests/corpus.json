        ["alice", "s3:GetBucketTagging", "arn:aws:s3:::b", "Allow", {"tags": [["aws:RequestTag", "protected", "1"]]}]
      ]
    },
    {
      "name": "set operators with negated operators (the transposition RustFS had)",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*",
           "Condition": {"ForAnyValue:StringNotEquals": {"s3:RequestObjectTagKeys": ["team", "cost"]}}}]}],
        "bob": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*",
           "Condition": {"ForAllValues:StringNotEquals": {"s3:RequestObjectTagKeys": ["team"]}}}]}]},
      "cases": [
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"tags": [["s3:RequestObjectTag", "team", "a"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"tags": [["s3:RequestObjectTag", "team", "a"], ["s3:RequestObjectTag", "cost", "1"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny", {"tags": [["s3:RequestObjectTag", "team", "a"], ["s3:RequestObjectTag", "owner", "x"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny", {"tags": [["s3:RequestObjectTag", "owner", "x"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"tags": [["s3:RequestObjectTag", "team", "a"]]}],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"tags": [["s3:RequestObjectTag", "team", "a"], ["s3:RequestObjectTag", "x", "1"]]}],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny", {"tags": [["s3:RequestObjectTag", "owner", "x"]]}],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"]
      ]
    },
    {
      "name": "a time window (DateGreaterThan and DateLessThan are strict)",
      "identity": {"*": [{"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": "s3:GetObject", "Resource": "*",
         "Condition": {"DateGreaterThan": {"aws:CurrentTime": "2026-01-01T00:00:00Z"}, "DateLessThan": {"aws:CurrentTime": "2027-01-01T00:00:00Z"}}},
        {"Effect": "Allow", "Action": "s3:ListBucket", "Resource": "*", "Condition": {"NumericLessThan": {"aws:EpochTime": 1800000000}}},
        {"Effect": "Allow", "Action": "s3:PutObject", "Resource": "*", "Condition": {"DateLessThanEquals": {"aws:EpochTime": "2026-09-29T12:00:00Z"}}}]}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow", {"time": "2026-01-01T00:00:01Z"}],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "ImplicitDeny", {"time": "2026-01-01T00:00:00Z"}],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "ImplicitDeny", {"time": "2025-12-31T23:59:59Z"}],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "ImplicitDeny", {"time": "2027-01-01T00:00:00Z"}],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow", {"time": "2026-12-31T23:59:59.999Z"}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "Allow"],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "ImplicitDeny", {"time": "2027-06-01T00:00:00Z"}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ImplicitDeny", {"time": "2026-09-29T12:00:01Z"}]
      ]
    },
    {
      "name": "numbers: s3:max-keys, with and without IfExists",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::b",
          "Condition": {"NumericLessThanEquals": {"s3:max-keys": "100"}}}}],
        "bob": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::b",
          "Condition": {"NumericLessThanEqualsIfExists": {"s3:max-keys": 100}}}}]},
      "cases": [
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "Allow", {"s3": {"s3:max-keys": 100}}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "Allow", {"s3": {"s3:max-keys": 1}}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "ImplicitDeny", {"s3": {"s3:max-keys": 101}}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "Allow", {"s3": {"s3:max-keys": "100"}}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "ImplicitDeny", {"s3": {"s3:max-keys": "lots"}}],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "ImplicitDeny"],
        ["bob", "s3:ListBucket", "arn:aws:s3:::b", "Allow"],
        ["bob", "s3:ListBucket", "arn:aws:s3:::b", "Allow", {"s3": {"s3:max-keys": 99}}],
        ["bob", "s3:ListBucket", "arn:aws:s3:::b", "ImplicitDeny", {"s3": {"s3:max-keys": 1000}}]
      ]
    },
    {
      "name": "BoolIfExists on MFA denies long-term keys; Bool alone doesn't",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:DeleteObject", "Resource": "*", "Condition": {"BoolIfExists": {"aws:MultiFactorAuthPresent": "false"}}}]}],
        "bob": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:DeleteObject", "Resource": "*", "Condition": {"Bool": {"aws:MultiFactorAuthPresent": "false"}}}]}]},
      "cases": [
        ["alice", "s3:DeleteObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:DeleteObject", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"]
      ]
    },
    {
      "name": "require encryption on upload: StringNotEquals and Null on a missing header",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"StringNotEquals": {"s3:x-amz-server-side-encryption": "AES256"}}}]}],
        "bob": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"Null": {"s3:x-amz-server-side-encryption": "true"}}}]}],
        "admin": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"StringNotEqualsIfExists": {"s3:x-amz-server-side-encryption": "AES256"}}}]}]},
      "cases": [
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"s3": {"s3:x-amz-server-side-encryption": "AES256"}}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny", {"s3": {"s3:x-amz-server-side-encryption": "aws:kms"}}],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"s3": {"s3:x-amz-server-side-encryption": "aws:kms"}}],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["admin", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny", {"s3": {"s3:x-amz-server-side-encryption": "aws:kms"}}],
        ["admin", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["admin", "s3:PutObject", "arn:aws:s3:::b/k", "Allow", {"s3": {"s3:x-amz-server-side-encryption": "AES256"}}]
      ]
    },
    {
      "name": "a negated ARN operator on a missing key holds, even with IfExists",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"ArnNotLike": {"aws:SourceArn": "arn:aws:s3:::*"}}}]}],
        "bob": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"ArnNotLikeIfExists": {"aws:SourceArn": "arn:aws:s3:::*"}}}]}],
        "admin": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:*", "Resource": "*"},
          {"Effect": "Deny", "Action": "s3:PutObject", "Resource": "*", "Condition": {"ArnNotLike": {"aws:SourceArn": "arn:aws:s3:::*"}, "Null": {"aws:SourceArn": "false"}}}]}]},
      "cases": [
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "ExplicitDeny"],
        ["admin", "s3:PutObject", "arn:aws:s3:::b/k", "Allow"]
      ]
    },
    {
      "name": "policy variables are literal text before version 2012-10-17",
      "identity": {"alice": [{"Version": "2008-10-17", "Statement": {"Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::b/${aws:username}/*"}}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::b/alice/x", "ImplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::b/${aws:username}/x", "Allow"]
      ]
