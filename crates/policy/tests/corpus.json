        ["alice", "s3:GetObject", "arn:aws:s3:::b/users/x", "Allow"],
        ["session", "s3:GetObject", "arn:aws:s3:::b/users/x", "ImplicitDeny"],
        ["anonymous", "s3:GetObject", "arn:aws:s3:::b/anon/x", "Allow"],
