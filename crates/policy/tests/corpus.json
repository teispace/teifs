        ["alice", "s3:PutObject", "arn:aws:s3:::teams/blue/x", "ImplicitDeny"],
        ["alice", "s3:PutObject", "arn:aws:s3:::teams/blue/x", "Allow", {"tags": [["aws:PrincipalTag", "team", "blue"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::teams/shared/x", "ImplicitDeny", {"tags": [["aws:PrincipalTag", "team", "blue"]]}],
        ["alice", "s3:PutObject", "arn:aws:s3:::teams/blue/x", "ImplicitDeny", {"tags": [["aws:PrincipalTag", "team", "b*"]]}],
        ["bob", "s3:PutObject", "arn:aws:s3:::teams/b*/x", "Allow", {"tags": [["aws:PrincipalTag", "team", "b*"]]}],
        ["alice", "s3:DeleteObject", "arn:aws:s3:::q/what?", "Allow"],
        ["alice", "s3:DeleteObject", "arn:aws:s3:::q/whatx", "ImplicitDeny"]
