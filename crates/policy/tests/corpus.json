        ["alice", "s3:PutObject", "arn:aws:s3:::acl/k", "Allow", {"s3": {"s3:x-amz-acl": "private"}}],
        ["alice", "s3:PutObject", "arn:aws:s3:::acl/k", "ImplicitDeny", {"s3": {"s3:x-amz-acl": "public-read"}}],
        ["alice", "s3:PutObject", "arn:aws:s3:::acl/k", "ImplicitDeny", {"s3": {"s3:x-amz-acl": "Private"}}],
