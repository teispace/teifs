        ["alice", "s3:DeleteObject", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:DeleteObjectVersion", "arn:aws:s3:::b/k", "ImplicitDeny"],
        ["alice", "s3:GetObjectTagging", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:GetObjectVersionTagging", "arn:aws:s3:::b/k", "ImplicitDeny"],
        ["bob", "s3:GetObjectVersion", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:GetObjectVersionTagging", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:DeleteObjectVersion", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "ImplicitDeny"]
      ]
    },
    {
      "name": "action names compare without case and take wildcards",
