    {
      "name": "versions are separate permissions",
      "identity": {
        "alice": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": ["s3:GetObject", "s3:DeleteObject", "s3:GetObjectTagging"], "Resource": "arn:aws:s3:::b/*"}}],
        "bob": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": ["s3:GetObject*", "s3:Delete*"], "Resource": "arn:aws:s3:::b/*"}}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"],
