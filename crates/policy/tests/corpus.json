        {"Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::b/${*}/x"},
        {"Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::teams/${aws:PrincipalTag/team, 'shared'}/*"},
        {"Effect": "Allow", "Action": "s3:DeleteObject", "Resource": "arn:aws:s3:::q/what${?}"}]}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::b/*/x", "Allow"],
