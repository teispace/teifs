        "bob": [{"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "s3:ListAllMyBuckets", "Resource": "arn:aws:s3:::*"},
          {"Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::b"}]}],
        "admin": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": "s3:ListAllMyBuckets", "Resource": "arn:aws:s3:::b"}}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-2026/a.jpg", "Allow"],
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-2026/a/b.jpg", "Allow"],
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-202/a.jpg", "ImplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-20266/a.jpg", "ImplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-2026/a.png", "ImplicitDeny"],
        ["alice", "s3:GetObject", "arn:aws:s3:::logs-2026/a.JPG", "ImplicitDeny"],
        ["bob", "s3:ListAllMyBuckets", "arn:aws:s3:::", "Allow"],
        ["bob", "s3:ListBucket", "arn:aws:s3:::b", "Allow"],
        ["bob", "s3:ListBucket", "arn:aws:s3:::b/", "ImplicitDeny"],
        ["admin", "s3:ListAllMyBuckets", "arn:aws:s3:::", "ImplicitDeny"]
      ]
    },
    {
      "name": "a Deny in any identity policy wins over an Allow in another",
