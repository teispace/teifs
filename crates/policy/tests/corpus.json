        "alice": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": ["s3:get*", "S3:LIST*"], "Resource": "*"}}],
        "bob": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": "s3:?utObject", "Resource": "*"}}],
        "admin": [{"Version": "2012-10-17", "Statement": {"Effect": "Allow", "Action": "*", "Resource": "*"}}]},
      "cases": [
        ["alice", "s3:GetObject", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:GetObjectTagging", "arn:aws:s3:::b/k", "Allow"],
        ["alice", "s3:ListBucket", "arn:aws:s3:::b", "Allow"],
        ["alice", "s3:ListAllMyBuckets", "arn:aws:s3:::", "Allow"],
        ["alice", "s3:PutObject", "arn:aws:s3:::b/k", "ImplicitDeny"],
        ["bob", "s3:PutObject", "arn:aws:s3:::b/k", "Allow"],
        ["bob", "s3:PutObjectTagging", "arn:aws:s3:::b/k", "ImplicitDeny"],
        ["admin", "s3:DeleteBucket", "arn:aws:s3:::b", "Allow"],
        ["admin", "s3:ListAllMyBuckets", "arn:aws:s3:::", "Allow"]
      ]
    },
    {
      "name": "resource wildcards stay within the ARN's parts",
